# Dados de clientes NUNCA vao para o repositorio.
data/test_contracts/*
!data/test_contracts/.gitkeep
data/extractions/*
!data/extractions/.gitkeep
data/knowledge_base/*
!data/knowledge_base/.gitkeep

# Diarios de movimentacao: contem caminhos de arquivos do cliente
data/diarios/

# Conversas gravadas: citam trechos dos contratos
data/trabalhos/
# O registro de cada resposta (C1, src/execucoes.py): conteudo das conversas.
data/execucoes/
# As frases de "ordem ao assistente" achadas nos trechos lidos (C6).
data/cerca/
# A jurisprudência do STJ baixada pela Biblioteca (src/jurisprudencia.py): 2,8 GB, deste computador.
data/jurisprudencia/

# Fila de aprovacoes e preferencias: caminhos e dados pessoais
data/aprovacoes.json
data/preferencias.json
# O anuncio de versao nova que o PAULUS consulta (cache local, nao e codigo).
data/atualizacao/

# Base local: cadastros e tarefas do escritorio
data/paulus.db
data/paulus.db-wal
data/paulus.db-shm

# Saidas geradas
*.xlsx
!docs/**/*.xlsx

# Ambiente
venv/
.venv/
__pycache__/
*.pyc
# O manifesto do instalador (sem ele o Windows pede administrador e borra a tela).
!tools/instalador/Instalador.manifest
.env

# Certificado digital: .pfx e chave privada. Nunca entra no repositorio -
# um e-CPF versionado e um e-CPF perdido.
data/certificado/
*.pfx
*.p12

# Contas de e-mail e historico de envios: guardam endereco, servidor e a
# senha protegida pela conta do Windows.
data/contas_email.json
data/envios.json
data/assinaturas.json
# Certificados de conformidade gerados: nome do assinante e do documento.
data/conformidade/
# Extratos de apoio gerados: nome e e-mail de quem apoia.
data/apoio/
# A nuvem (src/nuvem.py): o segredo da instalacao (chave-paulus.dpapi), o sim
# do titular e o texto exato de cada envio - perguntas e trechos de documentos.
data/nuvem/

# Etapa 7. A sessao do navegador embutido guarda o token da conta de WhatsApp
# do escritorio - versionar isso e entregar a conta. Comprovantes e lancamentos
# sao dado financeiro do cliente.
data/sessoes/
data/conexoes.json
data/comprovantes/
# Recibo de salario e planilha do mes sao dado de pessoa e de dinheiro do
# escritorio: ficam na maquina, nunca no repositorio.
data/recibos/
data/exportacoes/
# O ritmo medido e desta maquina: o numero do computador de outra pessoa nao
# diz nada sobre o desta.
data/ritmo.json
data/clausulas.json

# Modelos de voz (Whisper) e audios gravados: pesados e de cliente, ficam so na maquina.
data/modelos/
data/gravacoes/

# A lixeira guarda por 30 dias o que foi apagado: arquivos de cliente, ficam so na maquina.
data/lixeira/

# A foto de quem usa e a logo do escritorio: sao desta maquina, nao do projeto.
data/marca/

# A biblioteca de metadata da camada de inteligencia: e do acervo desta
# maquina, e o que ha nela e mais sensivel que os proprios documentos.
data/conhecimento/

# Os agentes do escritorio (src/agentes.py): instrucoes escritas pelo
# escritorio, a medida de uso e as recusas. Os exemplos do produto moram em
# config/agentes/, que vai no git.
data/agentes/


# Base de demonstracao (tools/demo/criar_demo.py): gerada, nao versionada
data/demo/

# O que o tools/instalador/construir.py monta (Python, dependencias, instalador): grande e refeito a cada versao.
tools/instalador/_construcao/

# Gerados por maquina: o teste desta maquina e a calibracao baixada do servidor.
data/maquina.json
data/calibracao_servidor.json

# A janela aberta desta pasta de dados (src/desktop.py): porta e processo.
data/instancia.json

# A ultima copia do historico publico (Desenvolvimento aberto) e do mural.
data/publico/

# O acesso de fora: contas, sessoes e o registro de quem acessou.
data/acesso/
data/logs/

# A medicao da conversa (src/medicao.py, tools/medir.py): numeros locais, e o
# conjunto real tem perguntas e frases de documentos de cliente.
data/medicao/

# O indice lexico do Acervo (src/lexico.py, FTS5): refeito a partir dos documentos.
data/indice/

# A Biblioteca (docs/PROGRESSO-BIBLIOTECA.md): o material de consulta do
# escritorio (livros comprados, manuais), os textos baixados do Planalto e a
# biblioteca da demonstracao ficam fora do git.
data/aprendizado/
data/leis/
data/demo-biblioteca/

# W1: o PAVLVS no Word desta instalacao - certificado (com a chave do
# servidor), conexoes (resumo do token) e manifestos. Nunca no repositorio.
data/word/

# Os arquivos do editor ja guardados no Acervo (caminho e SHA-1 desta
# maquina) e os anexos trazidos da caixa para encaminhar: dados de quem usa.
data/editor_no_acervo.json
data/encaminhar/
