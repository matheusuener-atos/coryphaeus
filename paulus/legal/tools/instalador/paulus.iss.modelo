; O instalador do PAULUS (Inno Setup 6). Gerado pelo tools\instalador\construir.py,
; que troca os marcadores {{VERSAO}}, {{ORIGEM}}, {{SAIDA}} e {{ARTE}}.
;
; - Instala para o usuário, sem pedir administrador: %LOCALAPPDATA%\Programs\PAULUS.
; - Os dados do escritório ficam fora dali, em %LOCALAPPDATA%\PAULUS (o
;   PAULUS.exe diz ao programa). Reinstalar ou atualizar não toca neles.
; - Com o PAULUS já instalado, abrir o instalador pergunta: atualizar ou
;   desinstalar.
; - Oferece instalar o Ollama (o motor da IA local) e, se faltar, o WebView2
;   (a janela do programa). Os dois são baixados dos sites oficiais na hora.
; - A tela "Modelo de IA" faz o teste da máquina (sem IA) e mostra os modelos
;   com a nota e o tempo estimado aqui, o recomendado já marcado. O escolhido
;   é baixado na primeira abertura do PAULUS, com o andamento na tela.
; - Desinstalar pergunta se apaga os modelos de IA local e os dados; as
;   respostas padrão são não.
; - Silencioso (/VERYSILENT), a tela não aparece e nada é baixado, a menos que
;   venha /MODELO=nome (esse modelo) ou /MODELO=recomendado (o do teste).

#define Versao "{{VERSAO}}"
#define ChaveDesinstalar "Software\Microsoft\Windows\CurrentVersion\Uninstall\{8C3E6A2B-5F1D-4C9A-9B7E-2A4D6F8B0C11}_is1"

[Setup]
AppId={{8C3E6A2B-5F1D-4C9A-9B7E-2A4D6F8B0C11}
AppName=PAULUS Legal
AppVersion={#Versao}
AppVerName=PAULUS Legal {#Versao}
AppPublisher=Matheus Uener Silva
AppPublisherURL=https://paulus.ia.br
AppSupportURL=https://paulus.ia.br
DefaultDirName={localappdata}\Programs\PAULUS
DisableProgramGroupPage=yes
DefaultGroupName=PAULUS
PrivilegesRequired=lowest
OutputDir={{SAIDA}}
OutputBaseFilename=PAULUS-{#Versao}-instalador
SetupIconFile={{ORIGEM}}\app\frontend\img\paulus.ico
UninstallDisplayIcon={app}\PAULUS.exe
UninstallDisplayName=PAULUS Legal
Compression=lzma2/max
SolidCompression=yes
; A cara do app: o fundo papel no claro e o grafite no escuro, seguindo o tema
; do Windows, e o painel da esquerda na casca da marca (tools/instalador/arte,
; desenhado em HTML com as letras do app e fotografado pelo desenhar.py).
WizardStyle=modern dynamic
WizardBackColor=#faf9f6
WizardBackColorDynamicDark=#131312
WizardImageFile={{ARTE}}/lateral-100.png,{{ARTE}}/lateral-150.png,{{ARTE}}/lateral-200.png
WizardSmallImageFile={{ARTE}}/icone-100.png,{{ARTE}}/icone-150.png,{{ARTE}}/icone-200.png
WizardImageFileDynamicDark={{ARTE}}/lateral-100.png,{{ARTE}}/lateral-150.png,{{ARTE}}/lateral-200.png
WizardSmallImageFileDynamicDark={{ARTE}}/icone-escuro-100.png,{{ARTE}}/icone-escuro-150.png,{{ARTE}}/icone-escuro-200.png
; A primeira página é a de boas-vindas, com o painel da marca.
DisableWelcomePage=no
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
CloseApplications=yes

[Languages]
Name: "pt"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"

[Tasks]
Name: "atalho"; Description: "Criar um atalho na área de trabalho"
Name: "ollama"; Description: "Instalar o Ollama, o motor da IA local (baixa uns 700 MB do site ollama.com)"; Check: not OllamaInstalado

[Files]
Source: "{{ORIGEM}}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[InstallDelete]
; O código da versão anterior sai inteiro antes do novo entrar (os dados não
; estão aqui): arquivo que deixou de existir não fica esquecido na pasta.
Type: filesandordirs; Name: "{app}\app"
Type: filesandordirs; Name: "{app}\python"

[UninstallDelete]
; O que o Python cria depois de instalado (__pycache__) o desinstalador não
; conhece; sem isto, a pasta do programa ficava para trás.
Type: filesandordirs; Name: "{app}\app"
Type: filesandordirs; Name: "{app}\python"

[Icons]
Name: "{group}\PAULUS"; Filename: "{app}\PAULUS.exe"
Name: "{group}\Desinstalar o PAULUS"; Filename: "{uninstallexe}"
Name: "{autodesktop}\PAULUS"; Filename: "{app}\PAULUS.exe"; Tasks: atalho

[Run]
Filename: "{tmp}\OllamaSetup.exe"; Parameters: "/VERYSILENT /NORESTART /SUPPRESSMSGBOXES"; StatusMsg: "Instalando o Ollama…"; Flags: waituntilterminated; Check: BaixouOllama
Filename: "{tmp}\MicrosoftEdgeWebview2Setup.exe"; Parameters: "/silent /install"; StatusMsg: "Instalando o WebView2…"; Flags: waituntilterminated; Check: BaixouWebView2
Filename: "{app}\PAULUS.exe"; Description: "Abrir o PAULUS"; Flags: nowait postinstall skipifsilent

[Code]
var
  Baixar: TDownloadWizardPage;
  PaginaModelo: TWizardPage;
  ResumoMaquina: TNewStaticText;
  ListaModelos: TNewCheckListBox;
  NomesModelos: array of String;
  ModelosLidos: Boolean;
  EscolhaFeita: String;

function OllamaInstalado: Boolean;
begin
  Result := FileExists(ExpandConstant('{localappdata}\Programs\Ollama\ollama.exe'));
end;

function WebView2Instalado: Boolean;
var
  Versao: String;
begin
  Result :=
    (RegQueryStringValue(HKLM, 'SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Versao) and (Versao <> '') and (Versao <> '0.0.0.0')) or
    (RegQueryStringValue(HKCU, 'Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Versao) and (Versao <> '') and (Versao <> '0.0.0.0'));
end;

function BaixouOllama: Boolean;
begin
  Result := WizardIsTaskSelected('ollama') and FileExists(ExpandConstant('{tmp}\OllamaSetup.exe'));
end;

function BaixouWebView2: Boolean;
begin
  Result := FileExists(ExpandConstant('{tmp}\MicrosoftEdgeWebview2Setup.exe'));
end;

{ ------------------------------------------------ já instalado: atualizar ou desinstalar }

function InitializeSetup(): Boolean;
var
  Desinstalar: String;
  Escolha, Codigo: Integer;
begin
  Result := True;
  if WizardSilent then
    exit;
  if RegQueryStringValue(HKCU, '{#ChaveDesinstalar}', 'UninstallString', Desinstalar) then begin
    Escolha := TaskDialogMsgBox('O PAULUS já está instalado nesta máquina.',
      'Atualizar troca o programa pela versão {#Versao} e mantém os dados do escritório.' + #13#10 +
      'Desinstalar remove o programa e pergunta se apaga também os modelos de IA local e os dados.',
      mbConfirmation, MB_YESNOCANCEL, ['Atualizar ou reinstalar', 'Desinstalar'], 0);
    if Escolha = IDNO then begin
      Exec(RemoveQuotes(Desinstalar), '', '', SW_SHOW, ewWaitUntilTerminated, Codigo);
      Result := False;
    end else if Escolha = IDCANCEL then
      Result := False;
  end;
end;

{ ------------------------------------------------------------ a tela Modelo de IA }

procedure InitializeWizard;
begin
  Baixar := CreateDownloadPage(SetupMessage(msgWizardPreparing), 'Baixando o que o PAULUS precisa…', nil);

  PaginaModelo := CreateCustomPage(wpInfoAfter, 'Modelo de IA',
    'O modelo de linguagem que o PAULUS vai usar. O recomendado para esta máquina já vem marcado; escolha outro se preferir.');
  ResumoMaquina := TNewStaticText.Create(PaginaModelo);
  ResumoMaquina.Parent := PaginaModelo.Surface;
  ResumoMaquina.Left := 0;
  ResumoMaquina.Top := 0;
  ResumoMaquina.Width := PaginaModelo.SurfaceWidth;
  ResumoMaquina.WordWrap := True;
  ResumoMaquina.AutoSize := True;
  ResumoMaquina.Caption := 'Conferindo esta máquina (uns segundos, sem IA)…';

  ListaModelos := TNewCheckListBox.Create(PaginaModelo);
  ListaModelos.Parent := PaginaModelo.Surface;
  ListaModelos.Left := 0;
  ListaModelos.Top := ScaleY(44);
  ListaModelos.Width := PaginaModelo.SurfaceWidth;
  ListaModelos.Height := PaginaModelo.SurfaceHeight - ScaleY(44);
end;

procedure LerModelos;
var
  Arquivo, Linha, Nome, Texto: String;
  Linhas: TArrayOfString;
  I, P, Codigo, Marcado: Integer;
  AlgumMarcado: Boolean;
begin
  ModelosLidos := True;
  Arquivo := ExpandConstant('{tmp}\modelos.txt');
  Exec(ExpandConstant('{app}\python\python.exe'),
       '"' + ExpandConstant('{app}\app\src\recomendar_modelo.py') + '" "' + Arquivo + '"',
       ExpandConstant('{app}\app'), SW_HIDE, ewWaitUntilTerminated, Codigo);
  ListaModelos.Items.Clear;
  SetArrayLength(NomesModelos, 0);
  AlgumMarcado := False;
  if LoadStringsFromFile(Arquivo, Linhas) then begin
    for I := 0 to GetArrayLength(Linhas) - 1 do begin
      Linha := Linhas[I];
      if Copy(Linha, 1, 8) = 'MAQUINA|' then
        ResumoMaquina.Caption := 'Esta máquina: ' + Copy(Linha, 9, Length(Linha)) + '.' + #13#10 +
          'Os tempos são estimativas; depois de baixar, "Medir" em Configurações › Modelos dá o número de verdade.'
      else if Copy(Linha, 1, 7) = 'MODELO|' then begin
        Linha := Copy(Linha, 8, Length(Linha));
        P := Pos('|', Linha); Nome := Copy(Linha, 1, P - 1); Linha := Copy(Linha, P + 1, Length(Linha));
        P := Pos('|', Linha); Texto := Copy(Linha, 1, P - 1);
        Marcado := StrToIntDef(Copy(Linha, P + 1, 1), 0);
        SetArrayLength(NomesModelos, GetArrayLength(NomesModelos) + 1);
        NomesModelos[GetArrayLength(NomesModelos) - 1] := Nome;
        ListaModelos.AddRadioButton(Texto, '', 0, Marcado = 1, True, nil);
        if Marcado = 1 then AlgumMarcado := True;
      end;
    end;
  end else
    ResumoMaquina.Caption := 'Não consegui conferir esta máquina agora. Escolha abaixo, ou deixe para depois.';
  { O resumo tem duas ou três linhas conforme a máquina: a lista vem logo abaixo dele. }
  ListaModelos.Top := ResumoMaquina.Top + ResumoMaquina.Height + ScaleY(10);
  ListaModelos.Height := PaginaModelo.SurfaceHeight - ListaModelos.Top;
  SetArrayLength(NomesModelos, GetArrayLength(NomesModelos) + 1);
  NomesModelos[GetArrayLength(NomesModelos) - 1] := '';
  ListaModelos.AddRadioButton('Não baixar agora — escolho depois, em Configurações › Modelos', '', 0, not AlgumMarcado, True, nil);
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if (CurPageID = wpFinished) and (EscolhaFeita <> '') then begin
    if OllamaInstalado then
      WizardForm.FinishedLabel.Caption := TrimRight(WizardForm.FinishedLabel.Caption) + #13#10#13#10 +
        'Ao abrir, o PAULUS começa a baixar o modelo ' + EscolhaFeita + '. O andamento aparece na tela inicial.'
    else
      WizardForm.FinishedLabel.Caption := TrimRight(WizardForm.FinishedLabel.Caption) + #13#10#13#10 +
        'Falta o Ollama, o motor da IA local: instale pelo site ollama.com. O modelo ' + EscolhaFeita +
        ' já fica escolhido; a tela inicial do PAULUS mostra como baixá-lo.';
    WizardForm.AdjustLabelHeight(WizardForm.FinishedLabel);
    WizardForm.RunList.Top := WizardForm.FinishedLabel.Top + WizardForm.FinishedLabel.Height + ScaleY(12);
  end;
  if WizardSilent and (ExpandConstant('{param:MODELO|}') = '') then
    exit;
  if (CurPageID = PaginaModelo.ID) and not ModelosLidos then begin
    WizardForm.NextButton.Enabled := False;
    WizardForm.Refresh;
    LerModelos;
    WizardForm.NextButton.Enabled := True;
  end;
end;

procedure GravarEscolha;
var
  I: Integer;
  Nome, Pasta: String;
begin
  Nome := '';
  for I := 0 to ListaModelos.Items.Count - 1 do
    if ListaModelos.Checked[I] then
      Nome := NomesModelos[I];
  if WizardSilent and (ExpandConstant('{param:MODELO|}') <> 'recomendado') then
    Nome := Lowercase(ExpandConstant('{param:MODELO|}'));
  Pasta := ExpandConstant('{localappdata}\PAULUS\dados');
  ForceDirectories(Pasta);
  EscolhaFeita := Nome;
  if Nome <> '' then
    SaveStringToFile(Pasta + '\escolha_do_instalador.json', '{"modelo": "' + Nome + '", "baixar": true}', False);
end;

function NextButtonClick(CurPageID: Integer): Boolean;
begin
  Result := True;
  if (PaginaModelo <> nil) and (CurPageID = PaginaModelo.ID) then
    GravarEscolha;
  if CurPageID = wpReady then begin
    Baixar.Clear;
    if WizardIsTaskSelected('ollama') then
      Baixar.Add('https://ollama.com/download/OllamaSetup.exe', 'OllamaSetup.exe', '');
    if not WebView2Instalado then
      Baixar.Add('https://go.microsoft.com/fwlink/p/?LinkId=2124703', 'MicrosoftEdgeWebview2Setup.exe', '');
    if WizardIsTaskSelected('ollama') or not WebView2Instalado then begin
      Baixar.Show;
      try
        try
          Baixar.Download;
        except
          if SuppressibleMsgBox('Não consegui baixar: ' + GetExceptionMessage + #13#10#13#10 +
                    'Dá para instalar o PAULUS mesmo assim e instalar o Ollama depois, pelo site ollama.com. Continuar?',
                    mbConfirmation, MB_YESNO, IDYES) = IDNO then
            Result := False;
        end;
      finally
        Baixar.Hide;
      end;
    end;
  end;
end;

{ ---------------------------------------------------------------- desinstalar }

procedure TirarModelosDoOllama(Lista: TArrayOfString);
var
  I, Codigo: Integer;
  Ollama: String;
  Ligou: Boolean;
begin
  Ollama := ExpandConstant('{localappdata}\Programs\Ollama\ollama.exe');
  if not FileExists(Ollama) then
    exit;
  Ligou := False;
  for I := 0 to GetArrayLength(Lista) - 1 do begin
    if Trim(Lista[I]) = '' then continue;
    Exec(Ollama, 'rm ' + Trim(Lista[I]), '', SW_HIDE, ewWaitUntilTerminated, Codigo);
    { O "ollama rm" fala com o servidor do Ollama; desligado, ele é ligado uma vez. }
    if (Codigo <> 0) and not Ligou then begin
      Exec(Ollama, 'serve', '', SW_HIDE, ewNoWait, Codigo);
      Sleep(4000);
      Ligou := True;
      Exec(Ollama, 'rm ' + Trim(Lista[I]), '', SW_HIDE, ewWaitUntilTerminated, Codigo);
    end;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Casa, Dados, Modelos, Lista, Texto: String;
  Baixados: TArrayOfString;
  I: Integer;
begin
  if CurUninstallStep <> usPostUninstall then
    exit;
  Casa := ExpandConstant('{localappdata}\PAULUS');
  Dados := Casa + '\dados';
  Modelos := Casa + '\modelos';

  { Os modelos primeiro: a lista do que o PAULUS baixou mora na pasta deles. }
  Lista := '';
  if LoadStringsFromFile(Modelos + '\ollama_baixados.txt', Baixados) then
    for I := 0 to GetArrayLength(Baixados) - 1 do
      if Trim(Baixados[I]) <> '' then
        Lista := Lista + '  • ' + Trim(Baixados[I]) + #13#10;
  if DirExists(Modelos) or (Lista <> '') then begin
    Texto := 'Desinstalar também os modelos de IA local?' + #13#10#13#10 +
             'Os modelos de voz e de tradução do PAULUS, em ' + Modelos + '.' + #13#10;
    if Lista <> '' then
      Texto := Texto + #13#10 + 'E os modelos de linguagem que o PAULUS baixou no Ollama:' + #13#10 + Lista;
    Texto := Texto + #13#10 + 'Os modelos que você baixou por fora do PAULUS e o próprio Ollama continuam instalados.' + #13#10 +
             'Se for reinstalar, escolha Não: assim não precisa baixar tudo de novo.';
    if SuppressibleMsgBox(Texto, mbConfirmation, MB_YESNO or MB_DEFBUTTON2, IDNO) = IDYES then begin
      if Lista <> '' then
        TirarModelosDoOllama(Baixados);
      DelTree(Modelos, True, True, True);
    end;
  end;

  if DirExists(Dados) then
    if SuppressibleMsgBox('Apagar também os DADOS do escritório em ' + Dados + '?' + #13#10 +
              '(conversas, Agenda, Financeiro, cadastros e os documentos da pasta do programa)' + #13#10#13#10 +
              'Os documentos das pastas que o Acervo vigia continuam onde estão, de qualquer jeito.' + #13#10 +
              'Se for reinstalar, escolha Não: os dados voltam na próxima instalação.',
              mbConfirmation, MB_YESNO or MB_DEFBUTTON2, IDNO) = IDYES then
      DelTree(Dados, True, True, True);

  RemoveDir(Casa);
end;
