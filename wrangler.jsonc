// ANTES DO MERGE (NFS-e na nuvem): o service binding SEFIN_MTLS, abaixo,
// aponta para o Worker auxiliar "paulus-nfse-mtls" - o deploy FALHA se ele
// nao existir. O dono cria o auxiliar uma vez (worker/nfse-mtls/index.js;
// worker/nfse/MTLS.md: sem rota e com o *.workers.dev desligado) e cadastra o
// segredo NFSE_CHAVE_MESTRA (npx wrangler secret put NFSE_CHAVE_MESTRA, valor
// de openssl rand -base64 32). Depois disso, o painel republica o auxiliar
// sozinho a cada certificado novo (com o token da Cloudflare dos Parametros).
//
// O site publico do PAULUS (paulus.ia.br) no Cloudflare, publicado pelo
// "npx wrangler deploy" que o Workers Builds roda a cada push.
//
// So a pasta site/ e o worker/ vao para o ar. O resto do repositorio - o
// programa, os dados e o oauth_app.json com a chave do Google - nunca e
// publicado. As chaves do Mercado Pago sao segredos do Worker
// (npx wrangler secret put MP_ACCESS_TOKEN / MP_WEBHOOK_SECRET).
{
  "name": "paulus",
  "compatibility_date": "2026-09-25",
  // As rotas /api/* (a nuvem do PAULUS, o acesso de fora, a calibracao e o
  // aviso do Mercado Pago do plano); o resto e o site.
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // /politica-de-privacidade abre site/politica-de-privacidade/index.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // O Worker responde /api/* antes de procurar arquivo do site, e tambem
    // /conectar, a pagina em que o titular confirma o acesso de fora; /cadastro,
    // que leva ao checkout da Atos; e a Minha conta (PT e EN), que sai com a
    // politica de seguranca de conteudo (CSP) do worker/index.js. Sem estar aqui,
    // a pagina sai direto dos arquivos, sem a CSP. /admin volta para o painel da
    // Atos (301, atos.dev.br/admin): sem estar aqui, sairia a pagina antiga.
    "run_worker_first": ["/api/*", "/conectar", "/oauth/*", "/cadastro", "/cadastro/*", "/minha-conta", "/minha-conta/*", "/en/my-account", "/en/my-account/*", "/admin", "/admin/*"]
  },
  // Sem rota nenhuma aqui de proposito: o Worker atende so paulus.ia.br. Os
  // <escritorio>.paulus.ia.br do acesso de fora sao dos tuneis de cada
  // escritorio, e o Worker nunca faz proxy deles (worker/index.js recusa).
  //
  // APOIOS: o nome ficou do antigo "Apoiar o projeto" (removido em 02/10/2026);
  // hoje guarda so a calibracao (prefixo "calibracao:"). Renomear o binding
  // perderia o que esta guardado.
  "kv_namespaces": [
    { "binding": "APOIOS", "id": "c8011a70799b40b0b3215f4a01b2d28c" },
    // O acesso de fora (worker/tunel.js): os escritorios conectados e os
    // pedidos de conexao em andamento. So o hash do segredo de cada
    // instalacao fica aqui - nenhum dado do escritorio.
    { "binding": "ESCRITORIOS", "id": "34ff1c1c0d3e4c7a9bcf34bf3f6fe321" }
  ],
  // As rotas que criam cobranca aceitam poucas chamadas por endereco de
  // internet: quem tentar encher o painel de cobrancas falsas para no limite.
  // O mesmo limite vale para conferir nome e iniciar o acesso de fora.
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // A limpeza diaria do acesso de fora (worker/tunel.js, limparEscritorios):
  // libera os enderecos que nunca conectaram em 7 dias ou estao parados ha
  // mais de 180. Sem TUNEL_ATIVO e sem o KV ESCRITORIOS ela nao faz nada.
  // O de cada minuto manda a proxima leva das campanhas do painel admin
  // (worker/admin.js, enviarCampanhas; uma leitura do KV quando nao ha nada).
  "triggers": { "crons": ["17 6 * * *", "* * * * *"] },
  // A sitekey do Turnstile e publica (vai na pagina de /conectar e na tela de
  // entrar de cada escritorio). O widget "PAULUS" vale para paulus.ia.br e
  // todos os subdominios. O secret do widget e segredo do Worker
  // (TURNSTILE_SECRET), cadastrado no painel.
  // TUNEL_ATIVO "1" liga as rotas do acesso de fora; MAX_ESCRITORIOS e o
  // teto de escritorios conectados nesta fase. Nenhum dos tres e segredo.
  // GOOGLE_CLIENT_IDS: os clientes OAuth do PAULUS (o de aplicativo instalado,
  // do vinculo, e o web, da equipe). Identificador de cliente nao e segredo;
  // e contra ele que o Worker confere o id_token de quem e dono do endereco.
  //
  // A nuvem do PAULUS (worker/ia.js, paulus/legal/docs/PLANO-NUVEM.md):
  // IA_ATIVA "1" liga /api/ia/*. As chaves dos provedores dos modelos sao
  // segredos do Worker: DEEPINFRA_KEY (Llama, plano Advogado), MISTRAL_KEY
  // (Mistral Large 3, Escritorio) e ANTHROPIC_KEY (Claude, Plus) - npx wrangler
  // secret put <NOME>. Sem a chave de um, o plano dele responde 503. Os planos
  // (valor do mes e do ano, creditos, pessoas, modelo, recarga e recursos)
  // ficam em PLANOS_DE_FABRICA no worker/ia.js; o painel admin publica outros
  // numeros no KV (IA_PLANOS). Aqui ficam o teto de saida e de entrada de um
  // pedido e de pedidos por minuto. IA_CORTESIA: o SHA-256 dos e-mails da Conta Atos
  // com o plano de cortesia (so master@atos.dev.br, desde 11/10/2026) - o resumo, e nao o
  // e-mail, porque este arquivo e publico.
  //
  // O painel admin (worker/admin.js, worker/admin-api.md) mora em atos.dev.br/admin: a Atos confere quem
  // entra (a Conta Atos, a equipe dela e o papel), liga o GitHub e encaminha /api/admin/pavlvs/* ate aqui pelo
  // service binding dela, assinado com o segredo PAINEL_SEGREDO_PAVLVS (o MESMO valor nos dois Workers: npx
  // wrangler secret put PAINEL_SEGREDO_PAVLVS). Sem ele, o painel responde 503. RESEND_API_KEY (segredo) liga o
  // envio de e-mail.
  //
  // O emissor de NFS-e do PAVLVS (worker/nfse/) continua no Worker, mas o painel nao o expoe mais (as notas
  // sao da Atos). CF_ACCOUNT_ID: a conta Cloudflare do mTLS do auxiliar paulus-nfse-mtls (worker/nfse/mtls.js) e
  // da API dos tuneis. Identificador de conta nao e segredo.
  "vars": {
    "CF_ACCOUNT_ID": "54164f67b5d5eb33c0a1d325dfebb449",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFHNSwEPTb-CTWwV", "TUNEL_ATIVO": "1", "MAX_ESCRITORIOS": "20",
    "GOOGLE_CLIENT_IDS": "834374999044-k6ci1409n2i95m3akqkc23bfc2m8ujpe.apps.googleusercontent.com,834374999044-278vmq8hd7th777q084u0rthand7e1jn.apps.googleusercontent.com",
    "IA_ATIVA": "1",
    // A cobranca e da Atos (worker/atos.js): o PAVLVS nao fala com o Mercado Pago. Os segredos MP_ACCESS_TOKEN e
    // MP_WEBHOOK_SECRET deste Worker sairam em 11/10/2026.
    // A chave publica da conta Atos (atos.dev.br, "Entrar com Atos"): o
    // donoDoToken confere o id_token ES256 da Atos com ela (worker/identidade.js).
    // Nao e segredo. Trocar a chave la = acrescentar a nova aqui antes.
    "ATOS_JWKS": "[{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"de_6JI9TCEXk78hRFEzffNeJiuHC9cm7gHiXtUol6sQ\",\"y\":\"Gwu29O1smT_j9HCn6fYXdjReM-Pi76jGH5wKYN8OSRE\",\"kid\":\"atos-2026-10-09\",\"alg\":\"ES256\",\"use\":\"sig\"}]",
    "IA_MAX_SAIDA": "8000", "IA_MAX_ENTRADA_CARACTERES": "240000", "IA_POR_MINUTO": "40", "IA_CORTESIA": "eb3c0d6926364330978a82d4cb16563f1a88624f13d74627059ede8e1f5a3982" },
  // O medidor da nuvem: um Durable Object por conta (worker/ia.js, ContaIA).
  // SQLite, o tipo que o plano gratis da Cloudflare aceita.
  //
  // O emissor de NFS-e da nuvem (worker/nfse/emissor.js, EmissorNFSe): uma
  // instancia so (idFromName("pavlvs")), SQLite. O certificado e a chave da
  // NFS-e ficam cifrados nele com o segredo NFSE_CHAVE_MESTRA (npx wrangler
  // secret put NFSE_CHAVE_MESTRA; openssl rand -base64 32), que tambem cifra o
  // token da Cloudflare no KV. Trocar a mestra = instalar o certificado e colar
  // o token de novo. Sem rota hoje (saiu do painel admin).
  "durable_objects": { "bindings": [{ "name": "CONTAS_IA", "class_name": "ContaIA" }, { "name": "EMISSOR_NFSE", "class_name": "EmissorNFSe" }] },
  "migrations": [{ "tag": "v1-contas-ia", "new_sqlite_classes": ["ContaIA"] }, { "tag": "v2-emissor-nfse", "new_sqlite_classes": ["EmissorNFSe"] }],
  // A conexao com a Sefin (mTLS): todo pedido a Sefin/ADN sai pelo Worker
  // auxiliar paulus-nfse-mtls, que apresenta o certificado A1 (worker/nfse/MTLS.md,
  // worker/nfse/sefin.js, fetchPeloMtls). Veja a nota no topo: o auxiliar
  // precisa existir antes do deploy.
  "services": [{ "binding": "SEFIN_MTLS", "service": "paulus-nfse-mtls" }]
}
