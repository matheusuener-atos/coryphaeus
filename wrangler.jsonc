// O site publico do PAULUS (paulus.ia.br) no Cloudflare, publicado pelo
// "npx wrangler deploy" que o Workers Builds roda a cada push.
//
// So a pasta site/ e o worker/ vao para o ar. O resto do repositorio - o
// programa, os dados e o oauth_app.json com a chave do Google - nunca e
// publicado. As chaves do Mercado Pago sao segredos do Worker
// (npx wrangler secret put MP_ACCESS_TOKEN / MP_WEBHOOK_SECRET).
{
  "name": "paulus",
  "compatibility_date": "2026-09-25",
  // As rotas /api/* (pagamento do "Apoiar o projeto"); o resto e o site.
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // /politica-de-privacidade abre site/politica-de-privacidade/index.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // O Worker responde /api/* antes de procurar arquivo do site, e tambem
    // /conectar, a pagina em que o titular confirma o acesso de fora.
    "run_worker_first": ["/api/*", "/conectar", "/oauth/*"]
  },
  // Sem rota nenhuma aqui de proposito: o Worker atende so paulus.ia.br. Os
  // <escritorio>.paulus.ia.br do acesso de fora sao dos tuneis de cada
  // escritorio, e o Worker nunca faz proxy deles (worker/index.js recusa).
  //
  // O que o webhook do Mercado Pago confirmou: Pix pago, assinatura ativa.
  // So situacao, valor e data - nenhum dado de cartao ou de pessoa.
  "kv_namespaces": [
    { "binding": "APOIOS", "id": "c8011a70799b40b0b3215f4a01b2d28c" },
    // O acesso de fora (worker/tunel.js): os escritorios conectados e os
    // pedidos de conexao em andamento. So o hash do segredo de cada
    // instalacao fica aqui - nenhum dado do escritorio.
    { "binding": "ESCRITORIOS", "id": "34ff1c1c0d3e4c7a9bcf34bf3f6fe321" }
  ],
  // As rotas que criam cobranca aceitam poucas chamadas por endereco de
  // internet: quem tentar encher o painel de cobrancas falsas para no limite.
  // O mesmo limite vale para conferir nome e iniciar o acesso de fora.
  "ratelimits": [
    { "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // A limpeza diaria do acesso de fora (worker/tunel.js, limparEscritorios):
  // libera os enderecos que nunca conectaram em 7 dias ou estao parados ha
  // mais de 180. Sem TUNEL_ATIVO e sem o KV ESCRITORIOS ela nao faz nada.
  "triggers": { "crons": ["17 6 * * *"] },
  // A sitekey do Turnstile e publica (vai na pagina de /conectar e na tela de
  // entrar de cada escritorio). O widget "PAULUS" vale para paulus.ia.br e
  // todos os subdominios. O secret do widget e segredo do Worker
  // (TURNSTILE_SECRET), cadastrado no painel.
  // TUNEL_ATIVO "1" liga as rotas do acesso de fora; MAX_ESCRITORIOS e o
  // teto de escritorios conectados nesta fase. Nenhum dos tres e segredo.
  // GOOGLE_CLIENT_IDS: os clientes OAuth do PAULUS (o de aplicativo instalado,
  // do vinculo, e o web, da equipe). Identificador de cliente nao e segredo;
  // e contra ele que o Worker confere o id_token de quem e dono do endereco.
  "vars": { "TURNSTILE_SITEKEY": "0x4AAAAAAFHNSwEPTb-CTWwV", "TUNEL_ATIVO": "1", "MAX_ESCRITORIOS": "20",
    "GOOGLE_CLIENT_IDS": "834374999044-k6ci1409n2i95m3akqkc23bfc2m8ujpe.apps.googleusercontent.com,834374999044-278vmq8hd7th777q084u0rthand7e1jn.apps.googleusercontent.com" }
}
